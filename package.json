{
  "name": "cadence",
  "version": "1.0.0",
  "private": true,
  "packageManager": "pnpm@11.18.0",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1",
    "db:dev": "node scripts/db-dev.mjs",
    "build": "next build && node .neander/prepare-standalone.mjs",
    "start": "node .next/standalone/server.js",
    "check": "tsc --noEmit",
    "test": "node --test scripts/template.test.mjs",
    "db:seed": "node .neander/seed.mjs",
    "test:template": "node scripts/verify-template.mjs",
    "test:policy": "python3 scripts/check_repository.py",
    "verify": "pnpm run check && pnpm run test && pnpm run test:policy && pnpm run build",
    "test:production": "node scripts/verify-template.mjs"
  },
  "dependencies": {
    "@better-auth/drizzle-adapter": "1.7.14",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@next/env": "16.4.6",
    "better-auth": "1.7.26",
    "drizzle-orm": "0.45.2",
    "next": "16.4.6",
    "pg": "8.23.0",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@types/node": "24.13.3",
    "@types/pg": "8.23.1",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.7",
    "auth": "1.7.14",
    "drizzle-kit": "0.31.10",
    "embedded-postgres": "18.4.0-beta.17",
    "typescript": "7.0.2",
    "@playwright/test": "1.58.2"
  },
  "license": "MIT"
}
